    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Kotodama listens to your voice to turn spoken words into text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotodama はあなたの声を聞き取り、話した言葉を文字にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotodama 需要聆听您的声音，将话语转换为文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Kotodama uses speech recognition to transcribe what you say, on device or via Apple's servers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotodama は音声認識を使って、デバイス上または Apple のサーバーで話した内容を文字起こしします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotodama 使用语音识别在设备上或通过 Apple 服务器转写您所说的内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
