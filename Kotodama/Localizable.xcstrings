    "Claude is overloaded right now. Try again shortly.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude は現在混み合っています。しばらくしてからお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 当前负载过高。请稍后再试。"
