{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ is not supported by this engine. Try the other mode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのエンジンでは対応していません。別のモードをお試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎不支持 %@。请尝试另一种模式。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Academic": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学術的"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学术"
          }
        }
      }
    },
    "Add Item": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加项目"
          }
        }
      }
    },
    "Anthropic API key": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic API キー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic API 密钥"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能"
          }
        }
      }
    },
    "Apple Translate cannot handle %@ → %@. Add an Anthropic API key in Settings for cloud translation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Apple Translate cannot handle %1$@ → %2$@. Add an Anthropic API key in Settings for cloud translation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻訳は %@ → %@ に対応していません。クラウド翻訳を使うには「設定」で Anthropic API キーを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻译无法处理 %@ → %@。请在“设置”中添加 Anthropic API 密钥以使用云端翻译。"
          }
        }
      }
    },
    "Apple Translate cannot translate %@ to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Apple Translate cannot translate %1$@ to %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻訳は %@ を %@ に翻訳できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻译无法将 %@ 翻译为 %@。"
          }
        }
      }
    },
    "Apple Translate downloads language packs on first use.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻訳は初回使用時に言語パックをダウンロードします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 翻译会在首次使用时下载语言包。"
          }
        }
      }
    },
    "Apple speech models on this device · works offline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上の Apple 音声モデル · オフラインで動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备上的 Apple 语音模型 · 可离线使用"
          }
        }
      }
    },
    "Apple's speech servers asked us to retry. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の音声サーバーから再試行を求められました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 语音服务器要求重试。请再试一次。"
          }
        }
      }
    },
    "Apple's speech servers · needs network": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の音声サーバー · ネットワークが必要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 语音服务器 · 需要网络"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Automatic uses Apple Intelligence on device when it is available, then Claude if an API key is set, and finally built-in clean-up rules. Translation prefers Apple Translate on device and falls back to Claude.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」は利用可能ならデバイス上の Apple Intelligence を使い、次に API キーが設定されていれば Claude、最後に内蔵の整形ルールを使います。翻訳はデバイス上の Apple 翻訳を優先し、Claude にフォールバックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会优先使用设备上的 Apple 智能；若已设置 API 密钥则使用 Claude；最后使用内置的整理规则。翻译优先使用设备上的 Apple 翻译，并回退到 Claude。"
          }
        }
      }
    },
    "Business": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジネス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商务"
          }
        }
      }
    },
    "Cancelled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消。"
          }
        }
      }
    },
