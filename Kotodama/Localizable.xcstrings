          }
        }
      }
    },
    "Enhanced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高品質"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强"
          }
        }
      }
    },
    "Enhanced and Premium voices sound far more natural and run on device. Download them in Settings › Accessibility › Spoken Content › Voices, then pick them here. Voices marked Default are the compact ones that ship with iOS.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「高品質」と「プレミアム」の音声ははるかに自然で、デバイス上で動作します。「設定」›「アクセシビリティ」›「読み上げコンテンツ」›「声」でダウンロードし、ここで選択してください。「標準」の音声は iOS に付属するコンパクト版です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“增强”和“高级”语音更加自然，并在设备上运行。请在“设置”›“辅助功能”›“朗读内容”›“声音”中下载，然后在此选择。标记为“默认”的是 iOS 自带的精简语音。"
          }
        }
      }
    },
    "Everything you speak is kept here with its refined text and translations.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容はすべて、整えたテキストと翻訳とともにここに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您说过的所有内容都会与润色文本和翻译一起保存在这里。"
          }
        }
      }
    },
