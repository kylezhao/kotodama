    "Microphone access is off. Allow it in Settings to speak.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがオフです。話すには「設定」で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
